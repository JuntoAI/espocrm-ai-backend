# AI Backend Configuration

# Server
NODE_ENV=production
PORT=3001

# EspoCRM
ESPOCRM_URL=http://espocrm-app:8080

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# Gemini Models
GEMINI_DEFAULT_MODEL=gemini-3.5-flash
GEMINI_AVAILABLE_MODELS=gemini-3.5-flash,gemini-3.1-pro-preview,gemini-3.1-flash-lite-preview

# Session Management
SESSION_TIMEOUT_MS=1800000
MAX_CONTEXT_MESSAGES=20

# Rate Limiting
RATE_LIMIT_PER_MIN=30

# Logging
LOG_LEVEL=info

# MCP Server
MCP_SERVER_PATH=../EspoMCP/EspoMCP/build/index.js
